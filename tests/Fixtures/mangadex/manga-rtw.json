                "altTitles": [
                    {
                        "en": "Release That Witch"
                    },
                    {
                        "fr": "Relâchez cette Sorcière"
                    },
                    {
                        "ru": "Освободите эту Ведьму"
                    },
                    {
                        "zh": "放开那个女巫"
                    },
                    {
                        "uk": "Звільніть цю відьму"
                    },
